<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PulumiCrossCloud.Core\PulumiCrossCloud.Core.csproj" />
    <ProjectReference Include="Generated\neon\Pulumi.Neon.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Api" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);Generated\**</DefaultItemExcludes>
  </PropertyGroup>

  <Target Name="IncludeGeneratedNeonProviderInPackage" BeforeTargets="_GetBuildOutputFilesWithTfm">
    <ItemGroup>
      <BuildOutputInPackage Include="$(MSBuildProjectDirectory)\Generated\neon\bin\$(Configuration)\$(TargetFramework)\Pulumi.Neon.dll">
        <TargetPath>Pulumi.Neon.dll</TargetPath>
      </BuildOutputInPackage>
    </ItemGroup>
  </Target>

</Project>
