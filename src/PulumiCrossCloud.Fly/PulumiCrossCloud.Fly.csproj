<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\PulumiCrossCloud.Core\PulumiCrossCloud.Core.csproj" />
    <ProjectReference Include="Generated\fly\Pulumi.Fly.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Api" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);Generated\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Generated\fly\pulumi-plugin.json" Pack="true" PackagePath="content" Visible="false" />
    <None Include="Generated\fly\version.txt" Pack="true" PackagePath="content" Visible="false" />
  </ItemGroup>

  <Target Name="IncludeGeneratedFlyProviderInPackage" BeforeTargets="_GetBuildOutputFilesWithTfm">
    <ItemGroup>
      <BuildOutputInPackage Include="$(MSBuildProjectDirectory)\Generated\fly\bin\$(Configuration)\$(TargetFramework)\Pulumi.Fly.dll">
        <TargetPath>Pulumi.Fly.dll</TargetPath>
      </BuildOutputInPackage>
    </ItemGroup>
  </Target>
</Project>
