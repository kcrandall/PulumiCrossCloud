<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\PulumiCrossCloud.Core\PulumiCrossCloud.Core.csproj" />
    <ProjectReference Include="Generated\posthog\Pulumi.Posthog.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Api" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    <PackageReference Include="Pulumi.Command" Version="4.5.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);Generated\**</DefaultItemExcludes>
  </PropertyGroup>

  <Target
    Name="IncludeGeneratedPostHogProviderInPackage"
    BeforeTargets="_GetBuildOutputFilesWithTfm"
  >
    <ItemGroup>
      <BuildOutputInPackage Include="$(MSBuildProjectDirectory)\Generated\posthog\bin\$(Configuration)\$(TargetFramework)\Pulumi.Posthog.dll">
        <TargetPath>Pulumi.Posthog.dll</TargetPath>
      </BuildOutputInPackage>
    </ItemGroup>
  </Target>
</Project>
