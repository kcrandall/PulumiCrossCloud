<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\PulumiCrossCloud.Core\PulumiCrossCloud.Core.csproj" />
    <ProjectReference Include="Generated\upstash\Pulumi.Upstash.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Api" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);Generated\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Generated\upstash\pulumi-plugin.json" Pack="true" PackagePath="content" Visible="false" />
    <None Include="Generated\upstash\version.txt" Pack="true" PackagePath="content" Visible="false" />
  </ItemGroup>

  <Target
    Name="IncludeGeneratedUpstashProviderInPackage"
    BeforeTargets="_GetBuildOutputFilesWithTfm"
  >
    <ItemGroup>
      <BuildOutputInPackage Include="$(MSBuildProjectDirectory)\Generated\upstash\bin\$(Configuration)\$(TargetFramework)\Pulumi.Upstash.dll">
        <TargetPath>Pulumi.Upstash.dll</TargetPath>
      </BuildOutputInPackage>
    </ItemGroup>
  </Target>
</Project>
