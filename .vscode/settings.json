{
    "dotnet.defaultSolution": "APIApp.sln",
    "[csharp]": {
        "editor.defaultFormatter": "csharpier.csharpier-vscode",
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file"
    },
    "cSpell.includeRegExpList": [
        "/[a-zA-Z_][a-zA-Z0-9_]*/" // Regular expression for C# variable names
    ],
    "cSpell.ignoreRegExpList": [
        "/using\\s+[a-zA-Z0-9.]+;/g", // Ignore imports
        "/\"(.*?)\"/g"                // Ignore strings
    ],
    "cSpell.languageSettings": [
        {
            "languageId": "csharp",
            "includeRegExpList": ["[a-zA-Z_][a-zA-Z0-9_]*"], // Variable names regex
            "ignoreRegExpList": [
                "/using\\s+[a-zA-Z0-9.]+;/g", // Ignore using statements
                "/\".*?\"/g"                  // Ignore strings
            ]
        }
  ],
  "cSpell.words": [
    "Serilog",
    "Keycloak",
    "OpenTelemetry",
    "UAParser",
    "Npgsql",
    "Quartz",
    "Posthog",
    "Dtos",
    "Pulumi"
  ]
}